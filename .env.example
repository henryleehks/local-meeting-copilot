# Local Meeting Copilot development credentials
# Copy this file to .env and fill in only the providers you want to use.

# OpenAI answer drafting and optional transcription fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize

# Google Calendar OAuth desktop app credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Calendar OAuth public/native app credentials
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# Prototype server only
PORT=5174
HOST=127.0.0.1
